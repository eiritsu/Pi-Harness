{
  "name": "pi-harness",
  "private": true,
  "version": "0.1.0",
  "description": "Codex-style desktop shell on a vendored pi coding-agent kernel",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --filter '!@earendil-works/**' --workspace-concurrency=1 test",
    "test:watch": "pnpm -r --filter '!@earendil-works/**' --workspace-concurrency=1 test:watch",
    "typecheck": "pnpm -r --filter '!@earendil-works/**' typecheck",
    "lint": "pnpm -r --filter '!@earendil-works/**' lint"
  },
  "pnpm": {
    "overrides": {
      "@earendil-works/pi-ai": "workspace:*",
      "@earendil-works/pi-agent-core": "workspace:*",
      "@earendil-works/chord": "workspace:*",
      "@earendil-works/pi-telemetry": "workspace:*"
    }
  }
}
