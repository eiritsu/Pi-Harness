{
  "name": "@earendil-works/pi-ai",
  "version": "0.85.1",
  "description": "Unified LLM API with automatic model discovery and provider configuration",
  "type": "module",
  "main": "./src/index.ts",
  "sideEffects": [
    "./dist/compat.js",
    "./dist/images.js",
    "./dist/providers/images/register-builtins.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./compat": {
      "types": "./src/compat.ts",
      "import": "./src/compat.ts"
    },
    "./providers/*": {
      "types": "./src/providers/*.ts",
      "import": "./src/providers/*.ts"
    },
    "./api/*": {
      "types": "./src/api/*.ts",
      "import": "./src/api/*.ts"
    },
    "./utils/*": {
      "types": "./src/utils/*.ts",
      "import": "./src/utils/*.ts"
    },
    "./oauth": {
      "types": "./src/oauth.ts",
      "import": "./src/oauth.ts"
    },
    "./bedrock-provider": {
      "types": "./src/bedrock-provider.ts",
      "import": "./src/bedrock-provider.ts"
    },
    "./bun-oauth": {
      "types": "./src/bun-oauth.ts",
      "import": "./src/bun-oauth.ts"
    }
  },
  "bin": {
    "pi-ai": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "generate-models": "node scripts/generate-models.ts --strict",
    "hydrate-model-data": "node scripts/generate-models.ts --strict --data-only",
    "generate-model-catalog": "node scripts/generate-models.ts --strict --json-only --json-output ../../.artifacts/model-catalog",
    "generate-image-models": "node scripts/generate-image-models.ts --strict",
    "check:model-data": "node scripts/check-model-data.ts",
    "build": "npm run generate-models && npm run build:offline",
    "build:offline": "npm run check:model-data && tsgo -p tsconfig.build.json && shx rm -rf dist/providers/data && shx cp -r src/providers/data dist/providers/data",
    "test": "vitest --run",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@aws-sdk/client-bedrock-runtime": "3.1127.0",
    "@earendil-works/pi-telemetry": "workspace:*",
    "@google/genai": "2.21.0",
    "@smithy/node-http-handler": "4.12.1",
    "http-proxy-agent": "9.1.0",
    "https-proxy-agent": "9.1.0",
    "openai": "6.40.0",
    "partial-json": "0.1.7",
    "typebox": "1.3.27"
  },
  "keywords": [
    "ai",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "bedrock",
    "unified",
    "api"
  ],
  "author": "Mario Zechner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earendil-works/pi.git",
    "directory": "packages/ai"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@smithy/types": "^4.18.0",
    "@types/node": "22.19.19",
    "canvas": "3.2.3",
    "vitest": "4.1.9"
  }
}
